{
  "name": "@topazdex/id-connect",
  "version": "0.4.3",
  "description": "Add Topaz ID — a BNB Chain smart-wallet global account — to your dapp in one line.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "connectors": [
        "./dist/connectors.d.ts"
      ],
      "actions": [
        "./dist/actions.d.ts"
      ],
      "rainbow-kit": [
        "./dist/rainbow-kit.d.ts"
      ],
      "react": [
        "./dist/react.d.ts"
      ],
      "privy": [
        "./dist/privy.d.ts"
      ]
    }
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topazdex/topaz-id-connect.git"
  },
  "bugs": {
    "url": "https://github.com/topazdex/topaz-id-connect/issues"
  },
  "homepage": "https://id.topazdex.com/developers",
  "keywords": [
    "topaz",
    "topaz-id",
    "privy",
    "global-wallet",
    "smart-wallet",
    "account-abstraction",
    "erc-4337",
    "cross-app",
    "wagmi",
    "rainbowkit",
    "bnb-chain",
    "wallet"
  ],
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./connectors": {
      "import": {
        "types": "./dist/connectors.d.ts",
        "default": "./dist/connectors.js"
      },
      "require": {
        "types": "./dist/connectors.d.cts",
        "default": "./dist/connectors.cjs"
      }
    },
    "./actions": {
      "import": {
        "types": "./dist/actions.d.ts",
        "default": "./dist/actions.js"
      },
      "require": {
        "types": "./dist/actions.d.cts",
        "default": "./dist/actions.cjs"
      }
    },
    "./rainbow-kit": {
      "import": {
        "types": "./dist/rainbow-kit.d.ts",
        "default": "./dist/rainbow-kit.js"
      },
      "require": {
        "types": "./dist/rainbow-kit.d.cts",
        "default": "./dist/rainbow-kit.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./privy": {
      "import": {
        "types": "./dist/privy.d.ts",
        "default": "./dist/privy.js"
      },
      "require": {
        "types": "./dist/privy.d.cts",
        "default": "./dist/privy.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:build": "publint --strict && attw --pack",
    "prepublishOnly": "yarn build"
  },
  "peerDependencies": {
    "@privy-io/cross-app-connect": "^0.5.12",
    "@privy-io/react-auth": "^2 || ^3",
    "@rainbow-me/rainbowkit": "^2.2.3",
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19",
    "viem": "^2",
    "wagmi": "^2"
  },
  "peerDependenciesMeta": {
    "@privy-io/cross-app-connect": {
      "optional": true
    },
    "@privy-io/react-auth": {
      "optional": true
    },
    "@rainbow-me/rainbowkit": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "viem": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@privy-io/cross-app-connect": "^0.5.12",
    "@privy-io/react-auth": "^3.30.0",
    "@rainbow-me/rainbowkit": "^2.2.3",
    "@tanstack/react-query": "^5.59.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "publint": "^0.3.21",
    "react": "^19.0.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "viem": "2.52.0",
    "vitest": "^4.1.8",
    "wagmi": "^2.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
